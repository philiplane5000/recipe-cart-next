{
  "$jsonSchema": {
    "bsonType": "object",
    "additionalProperties": false,
    "required": [
      "_id",
      "createdAt",
      "description",
      "ingredients",
      "name",
      "schemaVersion",
      "servings",
      "steps",
      "visibility"
    ],
    "properties": {
      "_id": {
        "bsonType": "objectId"
      },
      "createdAt": {
        "bsonType": "date"
      },
      "description": {
        "bsonType": "string",
        "minLength": 1,
        "maxLength": 280
      },
      "ingredients": {
        "bsonType": "array",
        "minItems": 1,
        "items": {
          "bsonType": "object",
          "additionalProperties": false,
          "required": ["name", "quantity"],
          "properties": {
            "name": {
              "bsonType": "string",
              "minLength": 1
            },
            "quantity": {
              "bsonType": ["int", "double"],
              "minimum": 0
            },
            "unit": {
              "bsonType": "string",
              "minLength": 1
            },
            "notes": {
              "bsonType": "string",
              "minLength": 1
            }
          }
        }
      },
      "name": {
        "bsonType": "string",
        "minLength": 1
      },
      "schemaVersion": {
        "bsonType": ["int", "double"],
        "minimum": 1,
        "multipleOf": 1
      },
      "servings": {
        "bsonType": ["int", "double"],
        "minimum": 1,
        "multipleOf": 1
      },
      "steps": {
        "bsonType": "array",
        "minItems": 1,
        "items": {
          "bsonType": "string",
          "minLength": 1
        }
      },
      "visibility": {
        "bsonType": "string",
        "enum": ["private", "public"]
      },
      "contributorId": {
        "bsonType": "string",
        "minLength": 1
      },
      "image": {
        "oneOf": [
          {
            "bsonType": "object",
            "additionalProperties": false,
            "required": ["source", "key"],
            "properties": {
              "source": { "bsonType": "string", "enum": ["upload"] },
              "key": { "bsonType": "string", "minLength": 1 }
            }
          },
          {
            "bsonType": "object",
            "additionalProperties": false,
            "required": ["source", "url"],
            "properties": {
              "source": { "bsonType": "string", "enum": ["url"] },
              "url": { "bsonType": "string", "minLength": 1 }
            }
          }
        ]
      },
      "nutrition": {
        "bsonType": "object",
        "additionalProperties": false,
        "properties": {
          "calories": { "bsonType": ["int", "double"], "minimum": 0 },
          "carbohydrates": { "bsonType": ["int", "double"], "minimum": 0 },
          "fat": { "bsonType": ["int", "double"], "minimum": 0 },
          "protein": { "bsonType": ["int", "double"], "minimum": 0 },
          "saturatedFat": { "bsonType": ["int", "double"], "minimum": 0 },
          "sodium": { "bsonType": ["int", "double"], "minimum": 0 },
          "sugar": { "bsonType": ["int", "double"], "minimum": 0 }
        }
      },
      "preparationTimes": {
        "bsonType": "object",
        "additionalProperties": false,
        "required": ["cook", "prep", "total"],
        "properties": {
          "cook": {
            "bsonType": ["int", "double"],
            "minimum": 0,
            "multipleOf": 1
          },
          "prep": {
            "bsonType": ["int", "double"],
            "minimum": 0,
            "multipleOf": 1
          },
          "total": {
            "bsonType": ["int", "double"],
            "minimum": 0,
            "multipleOf": 1
          }
        }
      },
      "tags": {
        "bsonType": "array",
        "items": {
          "bsonType": "string",
          "minLength": 1
        }
      }
    }
  }
}
